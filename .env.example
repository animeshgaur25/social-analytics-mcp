# Required to call Apify's Instagram Profile Scraper and YouTube Scraper actors.
APIFY_API_TOKEN=replace-with-your-apify-token

# Optional: Google Gemini API key for generative insights and AI summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Optional operational settings.
APIFY_POLL_INTERVAL_SECONDS=2
APIFY_RUN_TIMEOUT_SECONDS=180
# Cache an account's latest-profile payload for 15 minutes.
PROFILE_CACHE_TTL_SECONDS=900

# Optional YouTube settings. The item budgets drive Apify credit usage per run;
# set YOUTUBE_MAX_SHORTS=0 to skip Shorts entirely.
APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper
YOUTUBE_MAX_VIDEOS=20
YOUTUBE_MAX_SHORTS=10

